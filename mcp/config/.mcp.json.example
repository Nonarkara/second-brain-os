{
  "//": "A+ coding path: filesystem forge (stdio). Absolute paths required.",
  "//_": "Optional alternate: Local REST API HTTP MCP when Obsidian is open — see docs/obsidian-mcp-setup.md",
  "//__": "Never commit real API keys or private vault paths you care about leaking.",

  "mcpServers": {
    "obsidian-bridge": {
      "command": "/opt/homebrew/bin/node",
      "args": ["/ABS/PATH/second-brain-os/mcp/obsidian-bridge/index.js"],
      "env": {
        "OBSIDIAN_VAULT": "/ABS/PATH/to/your/vault"
      }
    }
  }
}
